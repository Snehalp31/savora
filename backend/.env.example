APP_ENV=development
STORAGE_MODE=sqlite
# SQLite is used by default; no MySQL server is required.
# Optional absolute path for the SQLite file:
# SAVORA_DB_PATH=C:/path/to/savora.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MODEL_DIR=./artifacts/models

# Change these initial administrator credentials before deployment
ADMIN_EMAIL=admin@savora.local
ADMIN_PASSWORD=ChangeMe123!
